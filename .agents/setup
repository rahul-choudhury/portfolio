#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

echo "[setup] Ensuring Bun is available"
if ! command -v bun >/dev/null 2>&1; then
  curl -fsSL https://bun.sh/install | bash
fi

# Login shells skip ~/.bashrc when non-interactive, so keep bun on the default PATH.
if [ -x "$HOME/.bun/bin/bun" ]; then
  sudo ln -sf "$HOME/.bun/bin/bun" /usr/local/bin/bun
fi

echo "[setup] Installing dependencies from bun.lock"
install_started=$SECONDS
bun install --frozen-lockfile
echo "[setup] Dependency install completed in $((SECONDS - install_started))s"
